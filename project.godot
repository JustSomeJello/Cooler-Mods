[internationalization]

locale/translation_remaps={
"res://assetsNEW/graphics/HUD/logo/logo_en.png": PackedStringArray("res://assetsNEW/graphics/HUD/logo/logo_ja.png:ja")
}
locale/translations=PackedStringArray("res://assetsNEW/translations/UCG_T.en.translation", "res://assetsNEW/translations/UCG_T.fr.translation", "res://assetsNEW/translations/UCG_T.ja.translation", "res://assetsNEW/translations/UCG_T.ru.translation", "res://assetsNEW/translations/UCG_T.ro.translation", "res://assetsNEW/translations/UCG_T.bi.translation")

[layer_names]

2d_physics/layer_1="Walls"
2d_physics/layer_2="Player"
2d_physics/layer_3="Ghost"
2d_physics/layer_4="Baddie"
2d_physics/layer_5="Collectible"
2d_physics/layer_6="Goal"
2d_physics/layer_7="Dog"
2d_physics/layer_8="Horse"
2d_physics/layer_9="Horse Walls"
2d_physics/layer_16="Editor "
2d_physics/layer_17="Jump Walls"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/position_steps=4

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.435294, 0.537255, 0.635294, 1)
