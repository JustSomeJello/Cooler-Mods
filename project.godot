; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Uncanny Cat Golf"
config/description="play. now."
config/version="1.0.0"
run/main_scene="uid://blipbbly572f5"
config/use_custom_user_dir=true
config/custom_user_dir_name="Uncanny Cat Golf"
config/auto_accept_quit=false
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/use_filter=false
boot_splash/image="res://assetsNEW/graphics/misc/splashscreen.png"
config/icon="res://assetsNEW/graphics/player/costume_canny.png"
config/windows_native_icon="res://icon.ico"
boot_splash/minimum_display_time=3000
config/max_fps=0

[autoload]

ModLoader="*res://assetsNEW/scenes/mod_loader.gd"

[display]

window/size/viewport_width=768
window/size/viewport_height=512
window/size/window_width_override=1536
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="res://assetsNEW/graphics/misc/mouse1.png"

[filesystem]

import/blender/enabled=false

[global_group]

GlassSolids=""
goal="Goal Post"
costume_house_unlocks="Unlocks for costume house."
modifier_buttons=""

[gui]

theme/custom="uid://pjd7jukd5lh3"

